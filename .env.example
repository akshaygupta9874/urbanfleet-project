# ==============================================================================
# UrbanFleet - Monorepo & Docker Compose Environment Template
# ==============================================================================
# Copy this file to .env in the project root:
#   cp .env.example .env
#
# Generate RS256 cryptographic keys:
#   npm run keys:generate
# ==============================================================================

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Backing Infrastructure
# ------------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_admin_pwd

REDIS_PORT=6379
REDIS_PASSWORD=redis_pass_local
REDIS_URL=redis://:redis_pass_local@localhost:6379

KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092

# Database User Passwords (matches infra/init-databases.sql)
AUTH_DB_PASSWORD=auth_pass_local
DRIVER_DB_PASSWORD=driver_pass_local
RIDE_DB_PASSWORD=ride_pass_local
PAYMENT_DB_PASSWORD=payment_pass_local
NOTIFICATION_DB_PASSWORD=notif_pass_local

# ------------------------------------------------------------------------------
# 2. Ingress & Kong API Gateway
# ------------------------------------------------------------------------------
KONG_PORT=3001
KONG_ADMIN_PORT=8001

# ------------------------------------------------------------------------------
# 3. Security, Inter-Service Auth & JWT RS256 Keypair
# ------------------------------------------------------------------------------

# Run "npm run keys:generate" to produce valid Base64-encoded RS256 keys:
JWT_PRIVATE_KEY_BASE64=""
JWT_PUBLIC_KEY_BASE64=""

# Fallback secrets for local testing
JWT_ACCESS_SECRET=test-access-secret-only
JWT_REFRESH_SECRET=test-refresh-secret-only

# ------------------------------------------------------------------------------
# 4. Web Application & Cookies
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 5. Third-Party Integrations
# ------------------------------------------------------------------------------
# Cloudinary (Driver Service image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Payment Service)
RAZORPAY_KEY_ID=rzp_test_key
RAZORPAY_KEY_SECRET=sample
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# SendGrid (Notification Service)
SENDGRID_API_KEY=test-sendgrid-key
SENDGRID_FROM_EMAIL=no-reply@urbanfleet.com
