# PostgreSQL Master Admin (Initialization only)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_admin_secure_pwd

# Individual Service Database Passwords (must match infra/init-databases.sql)
AUTH_DB_PASSWORD=auth_pass_local
DRIVER_DB_PASSWORD=driver_pass_local
RIDE_DB_PASSWORD=ride_pass_local
PAYMENT_DB_PASSWORD=payment_pass_local
NOTIFICATION_DB_PASSWORD=notif_pass_local

# Inter-Service Internal Security
INTERNAL_SERVICE_KEY=urbanfleet_internal_secret

# Kafka & Redis
KAFKA_BROKERS=kafka:29092
REDIS_URL=redis://redis:6379

# RS256 Asymmetric Keypair (Base64 Encoded)
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# Razorpay & SendGrid
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
SENDGRID_API_KEY=SG.placeholder

# Cloudinary Media Pipeline
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend
FRONTEND_URL=http://localhost:5173

