{
  "name": "urbanfleet-monorepo",
  "version": "1.0.0",
  "description": "UrbanFleet Event-Driven Microservices Monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=@urbanfleet/contracts && npm run build --workspace=@urbanfleet/common",
    "build": "npm run build:packages && npm run build --workspaces --if-present",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "prisma:generate:all": "npm run prisma:generate --workspaces --if-present",
    "postinstall": "npm run build:packages && npm run prisma:generate:all",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "docker:infra": "docker compose up -d postgres redis kafka kafka-init kong",
    "db:push:all": "npm run prisma:push --workspaces --if-present",
    "db:migrate:all": "npm run prisma:migrate --workspaces --if-present",
    "keys:generate": "node scripts/generate-keys.js",
    "dlq:replay": "tsx scripts/replay-dlq.ts",
    "dev:auth": "npm run dev --workspace=@urbanfleet/auth-service",
    "dev:driver": "npm run dev --workspace=@urbanfleet/driver-service",
    "dev:ride": "npm run dev --workspace=@urbanfleet/ride-service",
    "dev:payment": "npm run dev --workspace=@urbanfleet/payment-service",
    "dev:notification": "npm run dev --workspace=@urbanfleet/notification-service"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/config": "^7.10.1",
    "axios": "^1.20.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1"
  }
}
