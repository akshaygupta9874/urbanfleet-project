# ==============================================================================
# UrbanFleet - Ride Service Production Environment Variables
# ==============================================================================

# Node Environment: production | development | test
NODE_ENV=production

# HTTP & WebSocket Port (Internal container port, routed via API Gateway / Kong)
PORT=4004

# PostgreSQL Connection String (Isolated database owned by ride_user)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://ride_user:replace_with_strong_ride_password@postgres:5432/urbanfleet_ride?schema=public

# Database Connection Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=2

# Redis Connection URL (Dedicated caching for Redis GEO, driver presence, locks with prefix ride:)
REDIS_URL=redis://:replace_with_redis_password@redis:6379

# Kafka Broker List (Comma-separated for cluster redundancy)
KAFKA_BROKERS=kafka:29092

# Internal Service-to-Service Shared Secret

# Internal Service Endpoints
DRIVER_SERVICE_URL=http://driver-service:4002

# RS256 Asymmetric Cryptographic Public Key (Base64 Encoded)
# Generate using: npm run keys:generate (Used for HTTP auth and WebSocket handshake authentication)
JWT_PUBLIC_KEY_BASE64="replace_with_base64_encoded_spki_rsa_public_key"

# Frontend Web Application Origin (Allowed for CORS)
FRONTEND_URL=https://app.urbanfleet.com
