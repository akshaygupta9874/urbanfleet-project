# ==============================================================================
# UrbanFleet - Notification Service Production Environment Variables
# ==============================================================================

# Node Environment: production | development | test
NODE_ENV=production

# HTTP Port (Internal container port, routed via API Gateway / Kong)
PORT=4003

# PostgreSQL Connection String (Isolated database owned by notification_user)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://notification_user:replace_with_strong_notif_password@postgres:5432/urbanfleet_notification?schema=public

# Database Connection Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=2

# Redis Connection URL (Dedicated caching with prefix notification:)
REDIS_URL=redis://:replace_with_redis_password@redis:6379

# Kafka Broker List (Comma-separated for cluster redundancy)
KAFKA_BROKERS=kafka:29092

# Internal Service-to-Service Shared Secret

# Internal Service Endpoints
AUTH_SERVICE_URL=http://auth-service:4001

# RS256 Asymmetric Cryptographic Public Key (Base64 Encoded)
# Generate using: npm run keys:generate (Matches JWT_PUBLIC_KEY_BASE64 from auth-service)
JWT_PUBLIC_KEY_BASE64="replace_with_base64_encoded_spki_rsa_public_key"

# Application Branding & Web URL
APP_NAME=UrbanFleet
FRONTEND_URL=https://app.urbanfleet.com

# SendGrid Transactional Email Service
# SENDGRID_API_KEY: Production API key starting with SG.
# SENDGRID_FROM_EMAIL: Verified sender email address in SendGrid dashboard
SENDGRID_API_KEY=SG.replace_with_your_sendgrid_production_api_key
SENDGRID_FROM_EMAIL=no-reply@urbanfleet.com
