# ==============================================================================
# UrbanFleet - Driver Service Production Environment Variables
# ==============================================================================

# Node Environment: production | development | test
NODE_ENV=production

# HTTP Port (Internal container port, routed via API Gateway / Kong)
PORT=4002

# PostgreSQL Connection String (Isolated database owned by driver_user)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://driver_user:replace_with_strong_driver_password@postgres:5432/urbanfleet_driver?schema=public

# Database Connection Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=2

# Redis Connection URL (Dedicated caching for driver profiles and state with prefix driver:)
REDIS_URL=redis://:replace_with_redis_password@redis:6379

# Kafka Broker List (Comma-separated for cluster redundancy)
KAFKA_BROKERS=kafka:29092

# Internal Service-to-Service Shared Secret
# Must match INTERNAL_SERVICE_KEY in auth-service, ride-service, payment-service, and notification-service
INTERNAL_SERVICE_KEY=replace_with_64_char_random_hex_secret

# Internal Service Endpoints
AUTH_SERVICE_URL=http://auth-service:4001

# RS256 Asymmetric Cryptographic Public Key (Base64 Encoded)
# Generate using: npm run keys:generate (Matches JWT_PUBLIC_KEY_BASE64 from auth-service)
JWT_PUBLIC_KEY_BASE64="replace_with_base64_encoded_spki_rsa_public_key"

# Frontend Web Application Origin (Allowed for CORS)
FRONTEND_URL=https://app.urbanfleet.com

# Cloudinary Storage Configuration (Required for driver profile photos & verification document uploads)
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
