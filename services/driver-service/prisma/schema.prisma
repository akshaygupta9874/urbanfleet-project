datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  APPROVED
  SUSPENDED
}

model DriverProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  licenseNumber      String             @unique @map("license_number") @db.VarChar(50)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  isAvailable        Boolean            @default(false) @map("is_available")
  rating             Decimal            @default(5.0) @db.Decimal(3, 2)
  totalTrips         Int                @default(0) @map("total_trips")
  totalEarningsPaise BigInt             @default(0) @map("total_earnings_paise")
  profilePhoto       Json?              @map("profile_photo")
  isVerified         Boolean            @default(false) @map("is_verified")

  // Banking & Payout Details
  accountHolderName     String?  @map("account_holder_name") @db.VarChar(100)
  accountNumber         String?  @map("account_number") @db.VarChar(50)
  ifscCode              String?  @map("ifsc_code") @db.VarChar(20)
  bankName              String?  @map("bank_name") @db.VarChar(100)
  upiId                 String?  @map("upi_id") @db.VarChar(100)
  passbookPhoto         Json?    @map("passbook_photo")
  razorpayContactId     String?  @map("razorpay_contact_id") @db.VarChar(255)
  razorpayFundAccountId String?  @map("razorpay_fund_account_id") @db.VarChar(255)

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  vehicles           Vehicle[]
  documents          Document[]

  @@map("driver_profiles")
}

model Vehicle {
  id              String        @id @default(uuid()) @db.Uuid
  driverProfileId String        @map("driver_profile_id") @db.Uuid
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  make            String        @db.VarChar(50)
  model           String        @db.VarChar(50)
  year            Int
  plateNumber     String        @unique @map("plate_number") @db.VarChar(50)
  color           String        @db.VarChar(30)
  category        String        @default("SEDAN") @db.VarChar(20)
  isActive        Boolean       @default(true) @map("is_active")
  images          Json?

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([driverProfileId])
  @@map("vehicles")
}

model Document {
  id              String             @id @default(uuid()) @db.Uuid
  driverProfileId String             @map("driver_profile_id") @db.Uuid
  driverProfile   DriverProfile      @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  type            String             @db.VarChar(50)
  documentUrl     String             @map("document_url") @db.VarChar(500)
  status          VerificationStatus @default(PENDING)
  expiresAt       DateTime?          @map("expires_at")
  rejectionReason String?            @map("rejection_reason")
  number          String?            @db.VarChar(100)
  frontImage      String?            @map("front_image") @db.VarChar(500)
  backImage       String?            @map("back_image") @db.VarChar(500)
  isVerified      Boolean            @default(false) @map("is_verified")

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([driverProfileId])
  @@map("documents")
}

model ProcessedEvent {
  eventId       String   @map("event_id") @db.Uuid
  consumerGroup String   @map("consumer_group") @db.VarChar(100)
  processedAt   DateTime @default(now()) @map("processed_at")

  @@id([eventId, consumerGroup])
  @@map("processed_events")
}
