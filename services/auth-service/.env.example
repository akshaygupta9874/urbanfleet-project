# ==============================================================================
# UrbanFleet - Auth Service Production Environment Variables
# ==============================================================================

# Node Environment: production | development | test
NODE_ENV=production

# HTTP Port (Internal container port, mapped via API Gateway / Kong)
PORT=4001

# PostgreSQL Connection String (Isolated database owned by auth_user)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://auth_user:replace_with_strong_auth_password@postgres:5432/urbanfleet_auth?schema=public

# Database Connection Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=2

# Redis Connection URL (Dedicated caching for access/refresh tokens with prefix auth:)
REDIS_URL=redis://:replace_with_redis_password@redis:6379

# Kafka Broker List (Comma-separated for cluster redundancy)
KAFKA_BROKERS=kafka:29092

# Internal Service-to-Service Shared Secret (Shared across all UrbanFleet microservices)

# RS256 Asymmetric Cryptographic Keypair (Base64 Encoded)
# Generate using: npm run keys:generate
# JWT_PRIVATE_KEY_BASE64: REQUIRED in production for signing tokens (Auth Service only)
# JWT_PUBLIC_KEY_BASE64:  REQUIRED in production for verifying tokens
JWT_PRIVATE_KEY_BASE64="replace_with_base64_encoded_pkcs8_rsa_private_key"
JWT_PUBLIC_KEY_BASE64="replace_with_base64_encoded_spki_rsa_public_key"

# Frontend Web Application Origin (Allowed for CORS)
FRONTEND_URL=https://app.urbanfleet.com

# Cookie Configuration for Production
# Set COOKIE_DOMAIN to your apex domain (e.g., .urbanfleet.com) to share cookies across subdomains
COOKIE_DOMAIN=.urbanfleet.com
COOKIE_SECURE=true

# CSRF Token Expiration (in seconds, default: 3600 = 1 hour)
CSRF_TOKEN_EXPIRE_SECONDS=3600
