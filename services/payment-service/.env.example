# ==============================================================================
# UrbanFleet - Payment Service Production Environment Variables
# ==============================================================================

# Node Environment: production | development | test
NODE_ENV=production

# HTTP Port (Internal container port, routed via API Gateway / Kong)
PORT=4005

# PostgreSQL Connection String (Isolated database owned by payment_user)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://payment_user:replace_with_strong_payment_password@postgres:5432/urbanfleet_payment?schema=public

# Database Connection Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=2

# Redis Connection URL (Dedicated caching for payment idempotency and reconciliation with prefix payment:)
REDIS_URL=redis://:replace_with_redis_password@redis:6379

# Kafka Broker List (Comma-separated for cluster redundancy)
KAFKA_BROKERS=kafka:29092

# Internal Service-to-Service Shared Secret
# Must match INTERNAL_SERVICE_KEY in auth-service, driver-service, ride-service, and notification-service
INTERNAL_SERVICE_KEY=replace_with_64_char_random_hex_secret

# Internal Service Endpoints
RIDE_SERVICE_URL=http://ride-service:4004

# RS256 Asymmetric Cryptographic Public Key (Base64 Encoded)
# Generate using: npm run keys:generate (Matches JWT_PUBLIC_KEY_BASE64 from auth-service)
JWT_PUBLIC_KEY_BASE64="replace_with_base64_encoded_spki_rsa_public_key"

# Frontend Web Application Origin (Allowed for CORS)
FRONTEND_URL=https://app.urbanfleet.com

# Razorpay Payment Gateway Configuration
# RAZORPAY_KEY_ID: Live key identifier (starts with rzp_live_)
# RAZORPAY_KEY_SECRET: Live API secret
# RAZORPAY_WEBHOOK_SECRET: Secret configured in Razorpay dashboard for signature verification
RAZORPAY_KEY_ID=rzp_live_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret
