# ==============================================================================
# UrbanFleet - Frontend Web Application Environment Variables
# ==============================================================================

# API Gateway URL (Points to Kong ingress port 3001 in local dev, or domain in production)
VITE_API_URL=http://localhost:3001

# WebSocket Gateway URL (Points to Kong ingress port 3001 in local dev, or wss:// in production)
VITE_WS_URL=ws://localhost:3001

# Geoapify Location & Routing API Key
VITE_GEOAPIFY_API_KEY=replace_with_your_geoapify_key

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id.apps.googleusercontent.com
